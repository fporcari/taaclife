# Copia questo file in `.env` e riempi i valori. NON committare il .env reale.

# Database: file SQLite su volume persistente
DATABASE_URL=sqlite:////data/nutricoach.db

# Chiave Anthropic per la chat coach (serve dalla Fase 8 in poi)
ANTHROPIC_API_KEY=

# Modello usato dal coach. Default: Haiku (veloce, economico).
# Alternativa: claude-sonnet-4-6 per più qualità di dialogo.
COACH_MODEL=claude-haiku-4-5-20251001

# Segreti JWT: genera due stringhe casuali distinte, es. con: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
