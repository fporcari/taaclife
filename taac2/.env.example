# Copia questo file in `.env` e riempi i valori. NON committare il .env reale.

# Database: file SQLite su volume persistente
DATABASE_URL=sqlite:////data/nutricoach.db

# Segreti JWT: genera due stringhe casuali distinte, es. con: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Chiave di cifratura per le chiavi Anthropic degli utenti (a riposo nel db).
# Genera con: openssl rand -hex 32  (oppure una chiave Fernet valida)
ENCRYPTION_KEY=

# NOTA: qui NON va nessuna ANTHROPIC_API_KEY.
# Ogni utente inserisce la propria chiave dall'app; viene salvata cifrata.
